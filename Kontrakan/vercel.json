{
  "version": 2,
  "builds": [
    { "src": "server/services/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/services/index.js" },
    { "src": "/(.*)", "dest": "client/dist/$1" }
  ]
}
